# Copiar a .env (NO subir .env a GitHub)

# Microsoft Entra ID
TENANT_ID=00000000-0000-0000-0000-000000000000
API_CLIENT_ID=00000000-0000-0000-0000-000000000000
API_SCOPE=Pedidos.ReadWrite
# Orígenes del frontend separados por coma (local y GitHub Pages)
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://germanelgris.github.io

# Amazon RDS MySQL
DB_HOST=pedidos360-db.xxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_USER=admin
DB_PASSWORD=cambiar

# RabbitMQ: clúster de dos nodos en la misma EC2 (Management UI: rabbit1 en 15672, rabbit2 en 15673)
RABBITMQ_USER=pedidos360
RABBITMQ_PASSWORD=cambiar
# Secreto compartido por rabbit1 y rabbit2 para formar el clúster (generar con: openssl rand -hex 32)
RABBITMQ_ERLANG_COOKIE=cambiar
